<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions are declared by :core:data, alongside the worker that needs
         them, and merge in from there. -->

    <!--
        From Android 11 an app cannot see what else is installed unless it says
        what it is looking for. Nothing here inspects the package list, but
        handing a PDF or a note to another app resolves an intent, and without
        these the chooser is empty on a device that has a reader installed.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="*/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="text/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:name=".NotesApplication"
        android:allowBackup="false"
        android:appCategory="productivity"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Notes"
        android:usesCleartextTraffic="false"
        tools:targetApi="tiramisu">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Notes.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                obsidian://open and obsidian://search, as other apps and notes
                elsewhere write them. Only read: what a link means is decided
                in ObsidianUri, and a link naming a vault or note this app does
                not have opens the app and says so.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="obsidian" />
            </intent-filter>

            <!-- Long-pressing the launcher icon goes straight to a screen. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!--
            Quick capture. Exported because the point of it is that other apps
            can hand text over: a share from a browser, a selection from the
            text menu. It takes text and writes it to the scratchpad, and can
            do nothing else.
        -->
        <activity
            android:name=".feature.capture.CaptureActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/capture_title"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@style/Theme.Notes.Capture"
            android:windowSoftInputMode="adjustResize|stateVisible">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".widget.RecentNotesWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/recent_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.TasksWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/tasks_widget_info" />
        </receiver>

        <!--
            Hands a vault file to whatever app opens that type. A file:// URI
            out of the app's private storage is refused outright by Android,
            so a content URI with a one-shot read grant is the only way for a
            PDF or a video to reach a viewer.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- NotesApplication is a Configuration.Provider, so WorkManager is
             initialised on demand and androidx.startup must not do it first. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            tools:node="remove" />
    </application>
</manifest>
