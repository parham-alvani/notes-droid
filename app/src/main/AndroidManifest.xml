<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions are declared by :core:data, alongside the worker that needs
         them, and merge in from there. This one is the app lock's, which is
         a screen and so lives here. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Task reminders: an alarm at the minute asked for, and set again after
         a reboot. USE_EXACT_ALARM is granted on install from Android 13;
         before that SCHEDULE_EXACT_ALARM is, and was all there was. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />

    <!--
        From Android 11 an app cannot see what else is installed unless it says
        what it is looking for. Nothing here inspects the package list, but
        handing a PDF or a note to another app resolves an intent, and without
        these the chooser is empty on a device that has a reader installed.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="*/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="text/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:name=".NotesApplication"
        android:allowBackup="false"
        android:appCategory="productivity"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Notes"
        android:usesCleartextTraffic="false"
        tools:targetApi="tiramisu">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Notes.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                obsidian://open and obsidian://search, as other apps and notes
                elsewhere write them. Only read: what a link means is decided
                in ObsidianUri, and a link naming a vault or note this app does
                not have opens the app and says so.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="obsidian" />
            </intent-filter>

            <!-- Long-pressing the launcher icon goes straight to a screen. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!--
            Quick capture. Exported because the point of it is that other apps
            can hand text over: a share from a browser, a selection from the
            text menu. It takes text and writes it to the scratchpad, and can
            do nothing else.
        -->
        <activity
            android:name=".feature.capture.CaptureActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/capture_title"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@style/Theme.Notes.Capture"
            android:windowSoftInputMode="adjustResize|stateVisible">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!--
            The dictionary. Its label is what the text-selection menu shows,
            in this app and every other one, so it is the verb.
        -->
        <activity
            android:name=".feature.define.DefineActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/define_action"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@style/Theme.Notes.Sheet"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!--
            Home screen widgets, drawn with Glance. Each receiver is Glance's,
            and the widget it serves composes in a WorkManager session of
            Glance's own rather than inside the broadcast. The names are the
            ones the RemoteViews providers had: a placed widget is bound to
            its provider's class name, and renaming one empties the home
            screen on update.
        -->
        <receiver
            android:name=".widget.RecentNotesWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/recent_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.PinnedNotesWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/pinned_widget_info" />
        </receiver>

        <!-- One note, whole. Not exported: the launcher's answer to a pin
             request comes back through a PendingIntent this app made. -->
        <receiver
            android:name=".widget.NoteWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/note_widget_info" />
        </receiver>

        <!-- Exported because the launcher starts it; it checks the widget is this app's. -->
        <activity
            android:name=".widget.NoteWidgetConfigureActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/widget_note_pick"
            android:taskAffinity=""
            android:theme="@style/Theme.Notes">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".widget.TasksWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/tasks_widget_info" />
        </receiver>

        <!--
            Hands a vault file to whatever app opens that type. A file:// URI
            out of the app's private storage is refused outright by Android,
            so a content URI with a one-shot read grant is the only way for a
            PDF or a video to reach a viewer.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!--
            The vaults in the system file picker, one root each, so another
            app's upload or attach button can reach a note. Exported, but only
            the system picker holds MANAGE_DOCUMENTS; the app a file is picked
            for gets a grant on that one file and nothing else. Read-only.
        -->
        <provider
            android:name="me.parham1995.notes.data.VaultDocumentsProvider"
            android:authorities="${applicationId}.documents"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>

        <!-- NotesApplication is a Configuration.Provider, so WorkManager is
             initialised on demand and androidx.startup must not do it first. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            tools:node="remove" />
        <!-- The Stop button on the reading-aloud notification. -->
        <receiver
            android:name=".feature.note.ReadAloud$StopReading"
            android:exported="false" />

        <receiver
            android:name=".reminder.ReminderReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Quick Settings tiles: the capture and journal shortcuts, from the
             notification shade rather than the launcher. -->
        <service
            android:name=".tile.CaptureTile"
            android:exported="true"
            android:icon="@drawable/ic_tile_capture"
            android:label="@string/shortcut_capture_short"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <service
            android:name=".tile.TodayTile"
            android:exported="true"
            android:icon="@drawable/ic_tile_today"
            android:label="@string/shortcut_today_short"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>
</manifest>
