<?xml version="1.0" encoding="utf-8"?>
<!--
    One note, whole. The text is a list of lines that scrolls on Android 12 and
    up and a single text view before that; one of the two is shown, or the
    message asking for a note when none is bound.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_note_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/widget_headline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/widget_note_title"
        android:textColor="@color/naz_white"
        android:textDirection="firstStrong"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/note_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/widget_note_choose"
        android:textColor="@color/naz_card_text"
        android:textSize="13sp"
        android:visibility="gone" />

    <ListView
        android:id="@+id/note_lines"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="6dp"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:scrollbars="none"
        android:visibility="gone" />

    <TextView
        android:id="@+id/note_text"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:lineSpacingMultiplier="1.15"
        android:textColor="@color/naz_card_text"
        android:textDirection="firstStrong"
        android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>
