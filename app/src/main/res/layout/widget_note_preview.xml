<?xml version="1.0" encoding="utf-8"?>
<!--
    What the picker shows for the note widget on Android 12 and up: a title and
    bars for lines, so it reads the same in every language and shows nobody's
    note. Without one, One UI's "add to home screen" dialog says the widget
    could not be added while it is adding it.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:text="@string/widget_note_title"
        android:textColor="@color/naz_white"
        android:textSize="15sp"
        android:textStyle="bold" />

    <FrameLayout
        android:layout_width="150dp"
        android:layout_height="6dp"
        android:layout_marginTop="8dp"
        android:alpha="0.6"
        android:background="@drawable/widget_preview_line" />

    <FrameLayout
        android:layout_width="130dp"
        android:layout_height="6dp"
        android:layout_marginTop="8dp"
        android:alpha="0.6"
        android:background="@drawable/widget_preview_line" />

    <FrameLayout
        android:layout_width="160dp"
        android:layout_height="6dp"
        android:layout_marginTop="8dp"
        android:alpha="0.6"
        android:background="@drawable/widget_preview_line" />

    <FrameLayout
        android:layout_width="90dp"
        android:layout_height="6dp"
        android:layout_marginTop="8dp"
        android:alpha="0.6"
        android:background="@drawable/widget_preview_line" />

    <FrameLayout
        android:layout_width="140dp"
        android:layout_height="6dp"
        android:layout_marginTop="8dp"
        android:alpha="0.6"
        android:background="@drawable/widget_preview_line" />

    <FrameLayout
        android:layout_width="120dp"
        android:layout_height="6dp"
        android:layout_marginTop="8dp"
        android:alpha="0.6"
        android:background="@drawable/widget_preview_line" />
</LinearLayout>
