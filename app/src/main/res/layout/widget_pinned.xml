<?xml version="1.0" encoding="utf-8"?>
<!--
    Pinned notes as cards. Three containers, one shown at a time: a list and a
    grid that scroll, filled from RemoteCollectionItems on Android 12 and up,
    and a plain column of as many cards as fit for Android 10 and 11, which
    would otherwise need a RemoteViewsService for the same thing.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/widget_headline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:text="@string/widget_pinned_title"
        android:textColor="@color/naz_white"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/pinned_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/widget_pinned_empty"
        android:textColor="@color/naz_card_text"
        android:textSize="13sp"
        android:visibility="gone" />

    <ListView
        android:id="@+id/pinned_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="6dp"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:scrollbars="none"
        android:visibility="gone" />

    <GridView
        android:id="@+id/pinned_grid"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="6dp"
        android:horizontalSpacing="6dp"
        android:numColumns="2"
        android:scrollbars="none"
        android:stretchMode="columnWidth"
        android:verticalSpacing="0dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/pinned_cards"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical"
        android:visibility="gone" />
</LinearLayout>
