<?xml version="1.0" encoding="utf-8"?>
<!--
    What the picker shows for the tasks widget on Android 12 and up: the
    headline and bars for rows, so it reads the same in every language and
    shows nobody's tasks. The widget itself is composed with Glance; this is a
    picture of it, which a picker needs as a layout. Without one, One UI's
    "add to home screen" dialog says the widget could not be added while it is
    adding it.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:text="@string/tasks_title"
            android:textColor="@color/naz_white"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            android:paddingStart="10dp"
            android:paddingEnd="2dp"
            android:text="@string/widget_capture_glyph"
            android:textColor="@color/naz_white"
            android:textSize="18sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="150dp"
        android:layout_height="6dp"
        android:layout_marginTop="12dp"
        android:alpha="0.6"
        android:background="@drawable/widget_preview_line" />

    <FrameLayout
        android:layout_width="110dp"
        android:layout_height="6dp"
        android:layout_marginTop="10dp"
        android:alpha="0.6"
        android:background="@drawable/widget_preview_line" />

    <FrameLayout
        android:layout_width="130dp"
        android:layout_height="6dp"
        android:layout_marginTop="10dp"
        android:alpha="0.6"
        android:background="@drawable/widget_preview_line" />
</LinearLayout>
