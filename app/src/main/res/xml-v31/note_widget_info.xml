<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12 and up. Choosing a note is optional at placement, since a widget
    placed from a note's menu already has one; an empty one asks when tapped,
    and a placed one can be pointed at another note from the launcher.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:configure="me.parham1995.notes.widget.NoteWidgetConfigureActivity"
    android:description="@string/widget_note_description"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:minWidth="180dp"
    android:minHeight="110dp"
    android:previewLayout="@layout/widget_note_preview"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="3"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen"
    android:widgetFeatures="reconfigurable|configuration_optional" />
