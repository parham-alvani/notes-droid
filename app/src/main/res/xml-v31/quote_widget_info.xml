<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12 and up. The note is chosen at placement and can be changed from
    the launcher; the 30-minute period is what moves it to the next day's quote.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:configure="me.parham1995.notes.widget.NoteWidgetConfigureActivity"
    android:description="@string/widget_quote_description"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:minWidth="180dp"
    android:minHeight="110dp"
    android:previewLayout="@layout/widget_quote_preview"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen"
    android:widgetFeatures="reconfigurable|configuration_optional" />
